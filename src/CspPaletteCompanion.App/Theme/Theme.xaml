<!-- ═══ CSP SUITE SHARED FILE ══════════════════════════════════════════════════
     Reconcile with tools/suite-sync.ps1 (spec §0.1). Tier 1 — byte-identical.
       Companion : src/CspPaletteCompanion.App/Theme/Theme.xaml
       Mux       : src/CspMultiplexer.App/Theme/Theme.xaml
     ════════════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ══ §1.2 COLOUR TOKENS ═══════════════════════════════════════════════════ -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="WindowBrush" Color="#1C1D21"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#24262B"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#2D3036"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="#383B43"/>
  <SolidColorBrush x:Key="PressedBrush" Color="#424650"/>
  <SolidColorBrush x:Key="DisabledFillBrush" Color="#212328"/>

  <!-- Lines. DividerBrush is for internal separators only, never a control outline. -->
  <SolidColorBrush x:Key="BorderBrush" Color="#434750"/>
  <SolidColorBrush x:Key="BorderHoverBrush" Color="#5A5F6B"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#33363D"/>
  <SolidColorBrush x:Key="DisabledBorderBrush" Color="#33363D"/>

  <!-- Text. The ramp is strictly monotonic against PanelBrush: 14.5 > 7.05 > 5.76 > 4.68.
       DisabledTextBrush clears WCAG AA so the "turn this on in Settings" tooltips that
       land on disabled controls stay readable — that is why disabled state uses explicit
       brushes and never Opacity. -->
  <SolidColorBrush x:Key="TextBrush" Color="#F2F3F6"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#ADB1BA"/>
  <SolidColorBrush x:Key="SubtleBrush" Color="#9AA0AA"/>
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#8B8F99"/>

  <!-- Accent. AccentBrush also carries "success" — there is no SuccessBrush. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#72D2B1"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#86DEC1"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#5DB796"/>
  <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#24473D"/>
  <SolidColorBrush x:Key="AccentBorderBrush" Color="#3E6D5E"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#10271F"/>
  <SolidColorBrush x:Key="FocusBrush" Color="#A8E8D1"/>

  <!-- Semantic — three hues. The status fills are deliberately low-saturation: at a
       100px strip a saturated tint reads as an alert, which is wrong for "done". -->
  <SolidColorBrush x:Key="WarningBrush" Color="#D8A25E"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#F08078"/>
  <SolidColorBrush x:Key="AccentStatusBrush" Color="#1F2E2A"/>
  <SolidColorBrush x:Key="WarningStatusBrush" Color="#2E271D"/>
  <SolidColorBrush x:Key="ErrorStatusBrush" Color="#2E2222"/>

  <!-- Close button — its own hue by convention, not a semantic token. -->
  <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="ClosePressedBrush" Color="#A22318"/>

  <!-- QR. Warm off-white rather than #FFFFFF: a pure-white slab is the loudest object
       in a #1C1D21 window. 16.5:1 against the modules, ~5x what a decoder needs. -->
  <SolidColorBrush x:Key="QrPaperBrush" Color="#F2F4F1"/>
  <SolidColorBrush x:Key="QrModuleBrush" Color="#101216"/>

  <!-- ══ §1.3 TYPE RAMP ═══════════════════════════════════════════════════════ -->

  <!-- Two families. 11px is below the optical range of the Text face; the Small face
       is what stops 11px strings rendering with over-thick stems. -->
  <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="UiFontSmallFamily">Segoe UI Variable Small, Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Implicit. Drop TextWrapping and every caption in the suite becomes single-line
       and clips. Every keyed text style below bases on this one so the wrap survives. -->
  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- BlockLineHeight is not optional: every fixed text-block height in the spec is an
       exact multiple of a LineHeight, and the default strategy sizes line boxes from the
       installed font's ascent/descent instead, which makes that arithmetic untrue. -->
  <Style x:Key="TitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <Style x:Key="BodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmallFamily}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LineHeight" Value="15"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
  </Style>

  <!-- LineHeight 16, not 15: every reserved caption height in §4 is recomputed against
       16, including the status strip's 3-line 50px DetailText box. -->
  <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmallFamily}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
  </Style>

  <Style x:Key="AccentLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmallFamily}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LineHeight" Value="15"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
  </Style>

  <Style x:Key="OnAccentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
  </Style>

  <!-- MajorLabel and MinorLabel are Label elements carrying Target bindings, so a
       TargetType="TextBlock" style cannot reach them. -->
  <Style x:Key="FieldLabelStyle" TargetType="Label">
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmallFamily}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <!-- ══ §1.4 SPACING · §1.5 RADII · §1.6 HEIGHTS ═════════════════════════════ -->

  <sys:Double x:Key="SpacingHairline">1</sys:Double>
  <sys:Double x:Key="SpacingXs">4</sys:Double>
  <sys:Double x:Key="SpacingSm">8</sys:Double>
  <sys:Double x:Key="SpacingMd">12</sys:Double>
  <sys:Double x:Key="SpacingLg">16</sys:Double>
  <sys:Double x:Key="SpacingXl">24</sys:Double>

  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusControl">6</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">3</CornerRadius>

  <sys:Double x:Key="HeightCompact">28</sys:Double>
  <sys:Double x:Key="HeightDefault">32</sys:Double>
  <sys:Double x:Key="HeightPrimary">40</sys:Double>

  <!-- ══ WINDOW ═══════════════════════════════════════════════════════════════ -->

  <!-- Keyed, not implicit. An implicit "TargetType=Window" style is matched by the
       element's exact runtime type, so it never reaches MainWindow: the window then
       inherits no Foreground and every TextBlock without an explicit colour falls back
       to TextBlock's default black.
       Display formatting quantises glyph advances to whole pixels, which is what keeps
       an 11px caption's stem weights even. Ideal is better for large display type and
       worse across 11-13px, which is the entire ramp. -->
  <Style x:Key="AppWindowStyle" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
  </Style>

  <!-- ══ §2.1 PrimaryButtonStyle ══════════════════════════════════════════════ -->

  <Style x:Key="PrimaryButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource HeightPrimary}"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ControlTemplate.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="NoWrap"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
          </ControlTemplate.Resources>
          <Grid>
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <!-- The ring's outer edge coincides with the chrome's outer edge, so no fill
                 peeks at the corners and no radius arithmetic is needed. -->
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource AccentTextBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusControl}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource DisabledFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══ §2.2 ButtonStyle · SecondaryButtonStyle ══════════════════════════════ -->

  <Style x:Key="ButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource HeightDefault}"/>
    <Setter Property="MinWidth" Value="76"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <!-- UpdateSourceTooltips writes unlock instructions onto disabled controls; without
         this those explanations are invisible exactly when they matter. -->
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ControlTemplate.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="NoWrap"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
          </ControlTemplate.Resources>
          <Grid>
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusControl}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource DisabledFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle}"/>

  <!-- No HorizontalAlignment setter: baking Left into a visual style is what makes the
       secondary button look unusable at full width. Alignment is a call-site decision. -->
  <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}"/>

  <!-- ══ §2.3 CompactButtonStyle · LinkButtonStyle ════════════════════════════ -->

  <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
    <Setter Property="Height" Value="{StaticResource HeightCompact}"/>
    <Setter Property="MinWidth" Value="72"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>

  <Style x:Key="LinkButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource HeightCompact}"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmallFamily}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ControlTemplate.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="NoWrap"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
          </ControlTemplate.Resources>
          <Grid>
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource RadiusControl}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusControl}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══ §2.4 TitleButtonStyle · CloseButtonStyle · TitleToggleStyle ══════════ -->

  <!-- Foreground drives the glyph: each call site supplies an inline Path whose Stroke
       binds to the templated parent's Foreground, which these triggers move. -->
  <Style x:Key="TitleButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="{StaticResource HeightCompact}"/>
    <Setter Property="Height" Value="{StaticResource HeightCompact}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource RadiusControl}">
              <ContentPresenter Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusControl}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Windows convention: the close affordance turns red, not neutral grey. -->
  <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource CloseHoverBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource ClosePressedBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="TitleToggleStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="{StaticResource HeightCompact}"/>
    <Setter Property="Height" Value="{StaticResource HeightCompact}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource RadiusControl}">
              <ContentPresenter Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusControl}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      </Trigger>
      <!-- Declared after hover so a pinned button keeps reading as pinned under the
           pointer, which is the state the user is checking when they hover it. -->
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══ §2.5 ToggleSwitchStyle ═══════════════════════════════════════════════ -->

  <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <ControlTemplate.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
              <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/>
            </Style>
          </ControlTemplate.Resources>
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- The ring is drawn on the focus box, not the track, so a 2px pill ring
                 never eats the thumb. -->
            <Grid x:Name="FocusBox" Width="44" Height="28">
              <Grid Width="36" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="Track"
                        Background="{StaticResource RaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"/>
                <Border x:Name="Thumb"
                        Width="16"
                        Height="16"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{StaticResource MutedBrush}"
                        CornerRadius="8">
                  <Border.RenderTransform>
                    <TranslateTransform x:Name="ThumbShift" X="0"/>
                  </Border.RenderTransform>
                </Border>
              </Grid>
              <Border x:Name="FocusRing"
                      BorderBrush="{StaticResource FocusBrush}"
                      BorderThickness="2"
                      CornerRadius="14"
                      IsHitTestVisible="False"
                      Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Grid.Column="1"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource PressedBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
              <Setter TargetName="Thumb" Property="Background" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <!-- Travel 16 = track 36 - left margin 2 - thumb 16 - right margin 2. -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
              <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AccentTextBrush}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                     Storyboard.TargetProperty="X"
                                     To="16"
                                     Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                     Storyboard.TargetProperty="X"
                                     To="0"
                                     Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
              <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AccentTextBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource DisabledFillBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
              <Setter TargetName="Thumb" Property="Background" Value="{StaticResource DisabledTextBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ §2.6 SegmentRadioStyle ═══════════════════════════════════════════════ -->

  <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
    <Setter Property="Height" Value="{StaticResource HeightDefault}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmallFamily}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}">
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="CheckedDot"
                         Width="3"
                         Height="3"
                         Margin="0,0,4,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource DisabledTextBrush}"
                         Visibility="Collapsed"/>
                <TextBlock VerticalAlignment="Center"
                           Text="{TemplateBinding Content}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"/>
              </StackPanel>
            </Border>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusControl}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RaisedBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="#2A5348"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledFillBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <!-- Reachable: turn off both capture permissions and all four radios disable
                 with one still checked. Without the thicker outline and the dot the user
                 sees four identical grey boxes and no indication of what will be
                 extracted. Declared after the single-condition disabled trigger so it
                 wins. -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False"/>
                <Condition Property="IsChecked" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledFillBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
              <Setter TargetName="CheckedDot" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ §2.7 Stepper ═════════════════════════════════════════════════════════ -->

  <!-- One control with three zones, not three controls. 28 + 1 + 42 + 1 + 28 = 100.
       ClipToBounds is what lets the zero-radius buttons meet the rounded frame. -->
  <Style x:Key="StepperFrameStyle" TargetType="Border">
    <Setter Property="Width" Value="100"/>
    <Setter Property="Height" Value="{StaticResource HeightDefault}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource DisabledFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StepperButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="{StaticResource HeightCompact}"/>
    <Setter Property="Height" Value="{StaticResource HeightDefault}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="0">
              <ContentPresenter Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="0"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
      </Trigger>
      <!-- No fill change: the frame already carries the disabled fill, and a second
           disabled surface inside it reads as a seam. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Implicit. Supplies the count boxes' height, centred content, MinWidth, caret and
       selection brushes. -->
  <Style TargetType="TextBox">
    <Setter Property="Height" Value="{StaticResource HeightDefault}"/>
    <Setter Property="MinWidth" Value="42"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource AccentSurfaceBrush}"/>
    <Setter Property="SelectionOpacity" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <!-- Focus is a separate ring so the border thickness never changes: growing
                 the border re-lays out the text and makes the value jump on focus. -->
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusControl}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <!-- Declared last so it wins: the stepper's field is borderless and the
                 frame draws the focus ring for it. Two concentric rings otherwise. -->
            <Trigger Property="BorderThickness" Value="0">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledFillBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ §2.8 ComboBox ════════════════════════════════════════════════════════ -->

  <!-- The Aero default hardcodes light chrome a Background setter will not override, so
       the closed state, the toggle and the popup are all templated here. Opacity is set
       nowhere in this template — the stock pair multiplies to 22.5%. -->
  <Style TargetType="ComboBox">
    <Setter Property="Height" Value="{StaticResource HeightDefault}"/>
    <Setter Property="Padding" Value="10,0,32,0"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MaxDropDownHeight" Value="224"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <ControlTemplate.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="NoWrap"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
          </ControlTemplate.Resources>
          <Grid x:Name="TemplateRoot">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}"/>
            <ToggleButton x:Name="DropDownToggle"
                          Background="Transparent"
                          ClickMode="Press"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          IsTabStop="False"
                          OverridesDefaultStyle="True">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ContentSite"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              IsHitTestVisible="False"/>
            <TextBlock x:Name="Placeholder"
                       Margin="{TemplateBinding Padding}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SubtleBrush}"
                       IsHitTestVisible="False"
                       Text="Select an action"
                       Visibility="Collapsed"/>
            <Path x:Name="Chevron"
                  Width="12"
                  Height="12"
                  Margin="0,0,10,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Data="M 2,4.5 L 6,8.5 L 10,4.5"
                  IsHitTestVisible="False"
                  SnapsToDevicePixels="True"
                  Stretch="None"
                  Stroke="{StaticResource MutedBrush}"
                  StrokeEndLineCap="Round"
                  StrokeStartLineCap="Round"
                  StrokeThickness="1"/>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusControl}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="False"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="None">
              <Border MinWidth="{Binding ActualWidth, ElementName=TemplateRoot}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Margin="0,2,0,0"
                      Padding="4"
                      Background="{StaticResource PanelBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource RadiusCard}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="Placeholder" Property="Text" Value="No actions loaded"/>
            </Trigger>
            <Trigger Property="SelectedItem" Value="{x:Null}">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RaisedBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
              <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RaisedBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
              <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledFillBrush}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
              <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource DisabledTextBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- IsHighlighted, not IsMouseOver: WPF sets IsHighlighted when arrow-keying an open
       popup, and a full custom template has no Aero fallback to supply the missing
       keyboard selection. -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Height" Value="{StaticResource HeightDefault}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <ControlTemplate.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="NoWrap"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
          </ControlTemplate.Resources>
          <Border x:Name="ItemChrome"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource RadiusSmall}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource RaisedBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsHighlighted" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ §2.9 CardStyle · StripStyle ══════════════════════════════════════════ -->

  <!-- A #434750 outline on a #24262B fill survives a bad monitor; a 1.3:1 hairline does
       not. Padding 10,8: a card inside a 16px page gutter already has 16px of air
       outside it, so 10 inside gives an optical inset of 26 without wasting a fourth of
       the content width. -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
  </Style>

  <!-- No Background/BorderBrush setters: the connection strip and the status strip write
       both at runtime, and a setter would be fighting that assignment. Call sites set
       the initial values explicitly. -->
  <Style x:Key="StripStyle" TargetType="Border">
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
  </Style>

  <!-- ══ §2.11 ProgressBar ════════════════════════════════════════════════════ -->

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="3"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" ClipToBounds="True">
            <Rectangle x:Name="PART_Track"/>
            <Rectangle x:Name="PART_Indicator"
                       HorizontalAlignment="Left"
                       Fill="{TemplateBinding Foreground}"
                       RadiusX="1.5"
                       RadiusY="1.5"/>
            <Rectangle x:Name="Sliver"
                       Width="96"
                       Height="3"
                       HorizontalAlignment="Left"
                       Fill="{TemplateBinding Foreground}"
                       RadiusX="1.5"
                       RadiusY="1.5"
                       Visibility="Collapsed">
              <Rectangle.RenderTransform>
                <TranslateTransform x:Name="SliverShift" X="-96"/>
              </Rectangle.RenderTransform>
            </Rectangle>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- 406 = 428 content - 2 border - 20 padding. Update with the status strip
                 width. At X = 406 the sliver's left edge is at the track's right edge, so
                 it is fully out: no overshoot, no dead beat.
                 The storyboard is started and stopped by this trigger rather than left
                 running, because IsIndeterminate is bound to IsVisible at the call site —
                 a Forever storyboard on a collapsed bar in a Topmost window otherwise
                 runs on the composition thread for the whole process lifetime. -->
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Sliver" Property="Visibility" Value="Visible"/>
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="IndeterminateStory">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="SliverShift"
                                     Storyboard.TargetProperty="X"
                                     From="-96"
                                     To="406"
                                     Duration="0:0:1.4"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="IndeterminateStory"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ §2.12 PillBadgeStyle ═════════════════════════════════════════════════ -->

  <Style x:Key="PillBadgeStyle" TargetType="Border">
    <Setter Property="Height" Value="20"/>
    <Setter Property="MinWidth" Value="52"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="TextElement.FontFamily" Value="{StaticResource UiFontSmallFamily}"/>
    <Setter Property="TextElement.FontSize" Value="11"/>
    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding ClientCount}" Value="0">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource MutedBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ══ §2.13 DragHandoffButtonStyle ═════════════════════════════════════════ -->

  <Style x:Key="DragHandoffButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusControl}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#2A5348"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#1E3B33"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      </Trigger>
      <!-- The chip's whole purpose is being dragged into another application, and a drag
           in flight is the one moment the pointer has left the control. -->
      <Trigger Property="Tag" Value="dragging">
        <Setter Property="Background" Value="#1E3B33"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource DisabledFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══ §2.14 SwatchButtonStyle ══════════════════════════════════════════════ -->

  <!-- Background, BorderBrush and BorderThickness must be TemplateBinding: ShowPalette
       assigns all three as local values, which beat any style setter. A template that
       relies on setters renders 40 identical swatches and kills the whole feature.
       Rings stay strictly inside the 32px bounds so a highlighted swatch never overlaps
       a neighbour in the 4px-gutter WrapPanel. -->
  <Style x:Key="SwatchButtonStyle" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="SwatchChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusSmall}"/>
            <Border x:Name="HoverRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="HoverRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="HoverRing" Property="Visibility" Value="Visible"/>
              <Setter TargetName="HoverRing" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <!-- The one sanctioned Opacity in the suite: this control's entire content is
                 a colour, so there is no substitute brush. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="SwatchChrome" Property="Opacity" Value="0.5"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ §2.15 GhostSwatchStyle ═══════════════════════════════════════════════ -->

  <!-- Wordless: it shows the exact size, radius, count-per-row and pitch of what is
       about to arrive, replacing a two-line sentence. -->
  <Style x:Key="GhostSwatchStyle" TargetType="Rectangle">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="RadiusX" Value="3"/>
    <Setter Property="RadiusY" Value="3"/>
    <Setter Property="Fill" Value="{StaticResource DisabledFillBrush}"/>
    <Setter Property="Stroke" Value="{StaticResource DividerBrush}"/>
    <Setter Property="StrokeThickness" Value="1"/>
  </Style>

  <!-- ══ §2.16 ScrollBar ══════════════════════════════════════════════════════ -->

  <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
    <Setter Property="Width" Value="0"/>
    <Setter Property="Height" Value="0"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
    <Setter Property="Width" Value="4"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbChrome" Background="{StaticResource BorderBrush}" CornerRadius="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource BorderHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource MutedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The default WPF scroll bars are light grey and read as a rendering fault inside a
       dark window. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ §2.17 ToolTip ════════════════════════════════════════════════════════ -->

  <!-- Foreground is TextBrush, not MutedBrush: a tooltip is the primary surface for its
       own content. Vertical padding is 6, not 8 — a 1-to-2-line floating box looks
       inflated at 8. -->
  <Style TargetType="ToolTip">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="MaxWidth" Value="280"/>
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontSmallFamily}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Placement" Value="Bottom"/>
    <Setter Property="VerticalOffset" Value="4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <ControlTemplate.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="LineHeight" Value="16"/>
              <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
              <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
          </ControlTemplate.Resources>
          <Border Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusControl}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══ §2.18 QrFrameStyle ═══════════════════════════════════════════════════ -->

  <!-- An empty outlined square exactly the size of the incoming code is a slot, not a
       mystery. No placeholder text, no icon, no watermark. The code-present state
       (QrPaperBrush fill, zero border) is written at the call site. -->
  <Style x:Key="QrFrameStyle" TargetType="Border">
    <Setter Property="Width" Value="300"/>
    <Setter Property="Height" Value="300"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ══ §11 TRAY MENU ════════════════════════════════════════════════════════ -->

  <!-- The tray menu is a WPF ContextMenu, not a ContextMenuStrip, so it must carry the
       suite chrome itself: the stock template is light and would be the only Windows-
       default surface either app shows. -->
  <Style TargetType="ContextMenu">
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusCard}">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Height" Value="{StaticResource HeightDefault}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <ControlTemplate.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="NoWrap"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
          </ControlTemplate.Resources>
          <Grid>
            <Border x:Name="ItemChrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource RadiusSmall}">
              <ContentPresenter ContentSource="Header"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <!-- An overlay rather than a thickness on ItemChrome: a border on the chrome
                 would inset the header by 2px only while focused, so arrow-keying the
                 menu would jog every label sideways. -->
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource FocusBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource RaisedBrush}"/>
            </Trigger>
            <!-- Keyboard only: a mouse hover raises IsHighlighted alone, so the ring
                 stays off for the pointer and on for arrow-key navigation. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="4,4"/>
    <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{TemplateBinding Background}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
